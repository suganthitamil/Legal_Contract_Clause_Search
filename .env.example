# Copy to .env and change what you need. Every value is optional.

# --- generation (lccs answer / POST /answer) ---
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_FALLBACK=true          # server-side refusal fallback

# --- legal embedding model (optional) ---
# VOYAGE_API_KEY=pa-...
# EMBEDDER=voyage-law-2

# --- retrieval defaults ---
# SEARCH_MODE=hybrid            # dense | sparse | hybrid
# RERANK=true                   # used only when the reranker is downloaded
# CHUNKER=clause                # clause | fixed | sliding | recursive | semantic
# CHUNK_MAX_TOKENS=384

# --- vector store ---
# VECTOR_STORE=qdrant           # qdrant | chroma
# QDRANT_URL=http://localhost:6333   # use a Qdrant server instead of local files
